{
  "expo": {
    "name": "Picure",
    "slug": "picure",
    "scheme": "picure",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.saneag.picure",
      "adaptiveIcon": {
        "backgroundColor": "#0A84FF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        { "image": "./assets/splash-icon.png", "backgroundColor": "#ffffff", "imageWidth": 160 }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Picure reads your photos to build collages.",
          "savePhotosPermission": "Picure saves finished collages to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Picure uses the camera to take patient photos.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        { "faceIDPermission": "Picure uses biometrics to unlock the app." }
      ]
    ],
    "experiments": { "typedRoutes": true }
  }
}
